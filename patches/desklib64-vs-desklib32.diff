@@ -26,6 +26,15 @@
 
 #include <stddef.h>
 /* For NULL, size_t etc */
+#include <stdint.h>
+
+/* DeskLib64: a pointer inside an operating system data structure (a window or icon block, a menu, a message ...) is a 32 bit
+   word: the structures keep the layout that the OS reads and writes, so such a field is a dl_ptr, not a pointer.  The data
+   that it points to must be below 4 GB (the heaps of RISC OS 64 programs are).  DL_PTR makes one from a pointer, DL_P
+   gives the pointer back (as void *). */
+typedef uint32_t dl_ptr;
+#define DL_PTR(p) ((dl_ptr) (uintptr_t) (p))
+#define DL_P(v)   ((void *) (uintptr_t) (v))
 
 #ifdef __cplusplus
 extern "C" {
